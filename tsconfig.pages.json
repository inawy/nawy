{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "noImplicitReturns": false,
    "alwaysStrict": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["types/*.d.ts", "translations.js", "sounds.js", "share.js", "sheet-gestures.js", "banners.js", "date-format.js", "app.js"]
}
