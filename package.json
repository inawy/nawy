{
  "name": "nawy",
  "private": true,
  "description": "Nawy PWA. The app has no runtime dependencies. Dev tools only: Vite + TypeScript build the Core (src/core -> nawy-data.js, nawy-storage.js), Playwright runs browser tests. `npm test` runs the fast tests; `npm run build` copies the app into _site/.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build-site.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build:core": "node scripts/build-core.mjs",
    "check:core": "node scripts/check-core.mjs",
    "test:browser": "node --test tests/browser/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
